<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Cart</title>
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Poppins', sans-serif;
    }

    .cart-item {
      border-radius: 15px;
      background-color: white;
      box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 8px;
      padding: 15px;
      margin-bottom: 15px;
    }

    img {
      border-radius: 10px;
      object-fit: cover;
    }
  </style>
</head>

<body>
  <div class="container py-5">
    <h2 class="text-center text-primary fw-bold mb-4">My Cart</h2>
    <div id="cartContainer">
      <% if(message && message.length>0){ %>
        <p><%= message %></p>
        <% } %>

        <% if(carts && carts.length>0){ %>
        <% carts.forEach((cart)=>{ %>
            <div class="cart-item">
                <div class="row align-items-center">
                    <div class="col-md-2">
                    <img src="<%= cart.Product.image %>" alt="<%= cart.Product.name %>" class="img-fluid">
                    </div>
                    <div class="col-md-4">
                    <h5><%= cart.Product.name %></h5>
                    <p class="mb-1">Price: ₹<span class="itemPrice"><%= cart.Product.price %></span></p>
                    <div class="quantity d-flex align-items-center gap-2">
                        <a href="/remove-cart/<%= cart.id %>"><button class="btn rounded btn-sm">-</button></a>
                        <p class="mb-1">Quantity: <span class="itemQuantity"><%= cart.quantity %></span></p>
                        <a href="/add-cart/<%= cart.id %>"><button class="btn rounded btn-sm">+</button></a>
                    </div>
                    </div>
                    <div class="col-md-3">
                    <p class="mb-0">Subtotal: ₹<span class="itemSubtotal"><%= cart.Product.price * cart.quantity %></span></p>
                    </div>
                </div>
            </div>
        <% })  %>
        <% }else{ %>
          <h1 class="text-center">No products </h1>
          <% } %>
    </div>
    <h4 class="text-end mt-4">Total: ₹<span id="totalPrice"><%= totalAmount %></span></h4>
    <div class="text-end mt-3">
      <button onclick="handler()" class="btn btn-success">Proceed to Checkout</button>
     
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
   <script>
    async function handler(){
      const res=await fetch('http://localhost:5000/order');
      const data=await res.json();

      const options={
						"key": data.key_id,
						"amount": data.amount,
						"currency": "INR",
						"name": data.product_name,
						"handler": async function (response){
							alert("Payment Succeeded");
              await fetch('http://localhost:5000/success')
						},
						"prefill": {
							"name": data.name,
							"email": data.email
						},
					};
          const razorpayObject=new Razorpay(options)
          razorpayObject.on("payment.failed",function(res){
            alert("Payment failed!");
          })
          razorpayObject.open()
      }

  </script> 
</body>

</html>

</html>