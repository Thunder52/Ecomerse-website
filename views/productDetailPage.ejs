<%- include('partials/navbar') %>

<body>

  <div class="container mt-5">
    <div class="row">
      <div class="col-md-6 text-center">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid rounded shadow-lg" style="max-height: 400px" />
      </div>

      <div class="col-md-6">
        <h2 class="fw-bold"><%= product.name %></h2>
        <p class="text-muted">Category: <%= product.Category.title %></p>
        <h4 class="text-success">₹<%= product.price.toFixed(2) %></h4>

        <p class="mt-3"><strong>Description:</strong></p>
        <p><%= product.description %></p>

        <p><strong>Available Quantity:</strong> <%= product.quantity %></p>

          <form action="/add-cart" method="POST">
            <input type="hidden" name="productId" value="<%= product.id %>" />
            <button type="submit" class="btn btn-primary mt-3">Add to Cart</button>
          </form>
                    <form action="/review" method="post" class="mb-3 mt-3 d-flex">
            <input type="hidden" name="productId" value="<%= product.id %>">
            <input type="text" name="comment" class="form-control rounded-pill me-2" placeholder="Add a review..." required>
            <button type="submit" class="btn btn-dark rounded-pill px-3">add review</button>
          </form>        
        <div class="review mt-5">
          <% if(product.Reviews && product.Reviews.length > 0){ %>
          <div class="comment-list" style="max-height: 200px; overflow-y: auto">
            <% product.Reviews.forEach(review => { %>
            <div class="d-flex align-items-start mb-3">
              <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(review.User ? review.User.fullName : 'U') %>&background=random" alt="avatar" class="rounded-circle me-3" width="40" height="40" />
              <div class="bg-light p-3 rounded-3 w-100">
                <strong><%= review.User ? review.User.fullName : 'Anonymous'
                %></strong><br />
                <span class="text-muted"><%= review.title %></span>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <p class="text-muted text-center">No comments yet. Be the first!</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09
</body>