<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <style>
      body{
        height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .error p{
        color: red;

      }
      .content{
       box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
      }
    </style>
    <title>Regiter page</title>
  </head>
  <body>
      <div class="content container-fluid w-25 p-5">
        <h1 class="text-center">Register</h1>
        <div class="error">
          <% if(errors && errors.length>0){ %>
            <% errors.forEach((error)=>{ %>
              <p class="error-message"><%= error %></p>
              <% }) %>
            <% } %>
        </div>
        <form action="/register" method="post">
            <div class="mb-3">
                <label for="fullName" class="form-label">FullName</label>
                <input type="text" id="fullName" name="fullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" required />
            </div>
            <div class="h-100 w-100 d-flex justify-content-center"><button class="btn btn-primary" type="submit">Register</button></div>
            <div class="text-center mt-3">
              <p>Already have an account?&nbsp;<a href="/login">login</a></p>
            </div>
        </form>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
